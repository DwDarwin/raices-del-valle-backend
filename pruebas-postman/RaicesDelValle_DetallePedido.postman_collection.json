{
  "info": {
    "name": "Raíces del Valle - Detalle de pedido",
    "description": "Pruebas del CRUD de detalle_pedido. Antes de correrla: crear un pedido en MySQL (ver datos_prueba_detalle_pedido.sql) y revisar las variables idPedido e idProducto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Preparar datos",
      "item": [
        {
          "name": "Registrar usuario de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Prueba\",\n  \"documento\": \"10203040\",\n  \"telefono\": \"3001234567\",\n  \"correo\": \"cliente.prueba@raices.com\",\n  \"contrasena\": \"clave123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear producto de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Papa criolla\",\n  \"descripcion\": \"Cosecha de la semana\",\n  \"categoria\": \"TUBERCULOS\",\n  \"productor\": \"Familia Chindoy Muchavisoy\",\n  \"precio\": 16500,\n  \"unidadVenta\": \"canastilla 3 kg\",\n  \"stock\": 86,\n  \"estado\": \"PUBLICADO\",\n  \"imagen\": \"../assets/img/papacriolla.png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. CRUD detalle de pedido",
      "item": [
        {
          "name": "Crear detalle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/detalles-pedido",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalles-pedido"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPedido\": {{idPedido}},\n  \"idProducto\": {{idProducto}},\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"idDetalle\", pm.response.json().id); }\npm.test(\"Subtotal = precio x cantidad\", function () { const d = pm.response.json(); pm.expect(Number(d.subtotal)).to.eql(Number(d.precioUnitario) * d.cantidad); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar todos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/detalles-pedido",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalles-pedido"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/detalles-pedido/{{idDetalle}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalles-pedido",
                "{{idDetalle}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar por pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/detalles-pedido/pedido/{{idPedido}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalles-pedido",
                "pedido",
                "{{idPedido}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar cantidad",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/detalles-pedido/{{idDetalle}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "detalles-pedido",
                "{{idDetalle}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Cantidad actualizada a 5\", function () { pm.expect(pm.response.json().cantidad).to.eql(5); });"
                ]
              }
            }
          ]
        }
      ]
    },
